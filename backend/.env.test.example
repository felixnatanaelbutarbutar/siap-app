# Synthetic test environment configuration for backend integration tests
# Copy to .env.test and ensure a dedicated test PostgreSQL database exists (e.g. siap_test_db)
NODE_ENV=test
PORT=3099
DATABASE_URL="postgresql://siap_user:siap_password@localhost:5432/siap_test_db?schema=public"
JWT_SECRET="test_jwt_secret_key_for_jest_only"
CORS_ALLOWED_ORIGINS="http://localhost:5173"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="test_minio_access"
MINIO_SECRET_KEY="test_minio_secret"
MINIO_BUCKET="siap-files-test"
MINIO_PUBLIC_URL="http://localhost:9000/siap-files-test"
